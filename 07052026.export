	Busy=&gt; , 
	Active=&gt; , 
	CommandAborted=&gt; , 
	Error=&gt; , 
	ErrorID=&gt; , 
	ErrorIdent=&gt; , 
	Axis:=stBeltAxis1 );
	
fbStopBeltAxis1(
