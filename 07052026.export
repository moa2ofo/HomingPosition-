            <Single Name="TextBlobForSerialisation" Type="string">
// ******************************** Example calculate aux circular point ******************************************
IF bEnableCalcAuxCircPoint THEN

	// Calculate Circular AuxPoint Example
	FN_AuxCirclePoint(	I_arPointOrigin:= stOriginPoint  , 
						I_arPointDestination:=  stDestPoint, 
						I_bNegQuadrant:= bNegQuadrant, 
						I_enRoundCoord:= enX_Y, 
						I_bOrientAxisCoord:=0,
						O_arAuxPoint=&gt;  stAuxPoint);
						
	// Calculate Circular AuxPoint Example round block 2-3 program 
	FN_AuxCirclePoint(	I_arPointOrigin:= stRobotPathPlanner[1].stRobotPoints[2].arPos  , 
						I_arPointDestination:= stRobotPathPlanner[1].stRobotPoints[3].arPos, 
						I_bNegQuadrant:= bNegQuadrant, 
						I_enRoundCoord:= enX_Y, 
						I_bOrientAxisCoord:=0,
						O_arAuxPoint=&gt; stRobotPathPlanner[1].stRobotPoints[3].arAuxPos);
					
END_IF

// ********************************* Start a points sequence without Enable inteblocks with PolySlope or Path Smotth Slope ****************************************************

fbKinSeqStart(
	I_bEnable:= bEnableKinSeqStart, 
	I_uiInitPointNo:= iStartPoint, 
	I_uiEndPointNo:= iEndPoint, 
	I_stKinRef:=arRobotKinConfig[1],  
	I_iRepeatCycles:= iRepeatCycles, 
	O_bActive=&gt; , 
	O_bInputParametersError=&gt; , 
	O_bSigleCycleBufferedDone=&gt; , 
	O_bCompleteCyclesBufferedDone=&gt; , 
	O_uiNoOfBufferedCycles=&gt; , 
	IO_stRobotPoints:= stRobotPathPlanner[1].stRobotPoints);
	
fbPolySlopeSeq(
	I_bEnable:=bEnableKinSeqStartPolySlope , 
	I_uiInitPointNo:= iStartPoint, 
	I_uiEndPointNo:= iEndPoint, 
	I_stKinRef:=arRobotKinConfig[1],  
	I_iRepeatCycles:= iRepeatCycles, 
	O_bActive=&gt; , 
	O_bInputParametersError=&gt; , 
	O_bSigleCycleBufferedDone=&gt; , 
	O_bCompleteCyclesBufferedDone=&gt; , 
	O_uiNoOfBufferedCycles=&gt; , 
	IO_stRobotPoints:= stRobotPathPlanner[1].stRobotPoints);


// ******************************** Ottimization of path calculation " bSetAlwaysKinCountour" using switch on path at pick done and place done ************************************** 

FN_SwitchOnPath(
	Enable:= stRobotPathPlanner[1].stPathPlannerCmd.bRunPathPlanner, 
	Target:= stRobotPathPlanner[1].stRobotPoints[3].arPos, // Pick position
	FeedBack:=stRobotFbk[1].arPathCoordinates, 
	SwitchDist:= rSwitchDistance, 
	ApproxWindow:= rApproxWindow, 
	InOperation=&gt; , 
	InRange=&gt; bPickDone, 
	Error=&gt; );

	
FN_SwitchOnPath(
	Enable:= stRobotPathPlanner[1].stPathPlannerCmd.bRunPathPlanner, 
	Target:= stRobotPathPlanner[1].stRobotPoints[6].arPos, // place position
	FeedBack:=stRobotFbk[1].arPathCoordinates, 
	SwitchDist:= rSwitchDistance, 
	ApproxWindow:= rApproxWindow, 
	InOperation=&gt; , 
	InRange=&gt; bPlaceDone, 
	Error=&gt; );
	
	stRobotPathPlanner[1].stRobotPoints[4].bEnableCondition:=bPickDone;
	
	stRobotPathPlanner[1].stRobotPoints[7].bEnableCondition:=bPlaceDone;
	
	IF stPathPlannerFbk[1].usiBufferedBlock &gt;=2 THEN 
		stRobotPathPlanner[1].stPathPlannerCmd.bSetAlwaysKinContour:=TRUE;	
	ELSE
		stRobotPathPlanner[1].stPathPlannerCmd.bSetAlwaysKinContour:=FALSE;
	END_IF	

					
// ******************************** Example copy points inside the point table ( Palletizer ) **************************************
IF bTrxPoint THEN
	
	IF stRobotPathPlanner[1].stPathPlannerCmd.bRunPathPlanner = FALSE THEN
		bUpdatePlaceDone:=FALSE;
		iPlace:=0;
	END_IF

	(* Copy placement points layers on pallet *)
	IF stPathPlannerFbk[1].usiBufferedBlock = 3  THEN
		bUpdatePlaceDone:=FALSE;
		CASE iPlace OF
		
		0:
			// Copy place points product 1 to place points run
			prgRobotManagement.fbRobotPathPlanner[1].mCopyBlock(101,5);
			prgRobotManagement.fbRobotPathPlanner[1].mCopyBlock(102,6);
			prgRobotManagement.fbRobotPathPlanner[1].mCopyBlock(103,7);
	
			
		1:
			// Copy place points product 2 to place points run
			prgRobotManagement.fbRobotPathPlanner[1].mCopyBlock(111,5);
			prgRobotManagement.fbRobotPathPlanner[1].mCopyBlock(112,6);
			prgRobotManagement.fbRobotPathPlanner[1].mCopyBlock(113,7);
		
		
		2:
			// Copy place points product 3 to place points run
			prgRobotManagement.fbRobotPathPlanner[1].mCopyBlock(121,5);
			prgRobotManagement.fbRobotPathPlanner[1].mCopyBlock(122,6);
			prgRobotManagement.fbRobotPathPlanner[1].mCopyBlock(123,7);
			
		3:
			// Copy place points product n to place points run
		
	
		END_CASE
	
	END_IF
	
	// Place Point Block Done
	IF stPathPlannerFbk[1].usiBufferedBlock = 6 AND   stPathPlannerFbk[1].bMoveToDone AND NOT bUpdatePlaceDone THEN
		bUpdatePlaceDone:=TRUE;
		IF iPlace &lt; iPlaceMax  THEN
			iPlace:=iPlace +1;
		ELSE
			iPlace:=0;
			bPalletizeDone:=TRUE; 
		END_IF
	END_IF
END_IF	

// ******************************** Example belt tracking points update management ******************************************************
// Enable Example Belt Tracking Point Management
FN_SwitchOnPath(
	Enable:= stRobotPathPlanner[1].stPathPlannerCmd.bRunPathPlanner, 
	Target:= stRobotPathPlanner[1].stRobotPoints[3].arPos, // Pick position
	FeedBack:=stRobotFbk[1].arPathCoordinates, 
	SwitchDist:= rSwitchDistance, 
	ApproxWindow:= rApproxWindow, 
	InOperation=&gt; , 
	InRange=&gt; bPickDone, 
	Error=&gt; );

	
FN_SwitchOnPath(
	Enable:= stRobotPathPlanner[1].stPathPlannerCmd.bRunPathPlanner, 
	Target:= stRobotPathPlanner[1].stRobotPoints[6].arPos, // place position
	FeedBack:=stRobotFbk[1].arPathCoordinates, 
	SwitchDist:= rSwitchDistance, 
	ApproxWindow:= rApproxWindow, 
	InOperation=&gt; , 
	InRange=&gt; bPlaceDone, 
	Error=&gt; );
	
	IF stKinPathBlendingStatus[1].stBeltTrackingStatus.SYNCHRONIZED AND stRobotFbk[1].arPathCoordinates[3] &lt;= stRobotPathPlanner[1].stRobotPoints[3].arPos[3] 
		OR stRobotPathPlanner[1].stRobotPoints[3].bMoveToDone THEN
		bPickDone:=TRUE;
	ELSE
		bPickDone:=FALSE;
	END_IF
	
	// Tracking Pick Points
	stBeltValueData.In.AxisName := 'Belt1';
	ML_AxsGetBeltValueRT(Data:= stBeltValueData); //read current belt value	
	rTrackingPosBelt1:= (TRUNC(stBeltValueData.Out.Position*1000)/1000);
	rTrackingPosBelt1:=rTrackingPosBelt1/1000;
	IF rTrackingPosBelt1 &lt; 0.001 THEN
		rTrackingPosBelt1 :=0.001;
	END_IF
	
	IF (stPathPlannerFbk[1].usiBufferedBlock &lt;2  OR ( stPathPlannerFbk[1].usiBufferedBlock &gt;=5 AND stPathPlannerFbk[1].usiBufferedBlock &lt;=7 ) )  
		AND stKinPathBlendingStatus[1].stBeltTrackingStatus.DESYNCHRONIZED  AND NOT bSetBeltTrackingPickDone AND bEnableBeltTracking THEN  
		
		// Up Pick Synchro down direction
		stRobotPathPlanner[1].stRobotPoints[2].arPos[9]:=rTrackingPosBelt1;
		stRobotPathPlanner[1].stRobotPoints[2].arPos[10]:=0;
		// Pick Synchro
		stRobotPathPlanner[1].stRobotPoints[3].arPos[9]:=rTrackingPosBelt1;
		stRobotPathPlanner[1].stRobotPoints[3].arPos[10]:=0;
		// Up Pick Synchro up direction
		stRobotPathPlanner[1].stRobotPoints[4].arPos[9]:=rTrackingPosBelt1;
		stRobotPathPlanner[1].stRobotPoints[4].arPos[10]:=0;
		bSetBeltTrackingPickDone:=TRUE;
	END_IF
	
	IF stKinPathBlendingStatus[1].stBeltTrackingStatus.SYNCHRONIZED  OR stKinPathBlendingStatus[1].stBeltTrackingStatus.SYNCHRONIZING 
		OR NOT stRobotPathPlanner[1].stPathPlannerCmd.bRunPathPlanner   THEN
		bSetBeltTrackingPickDone:=FALSE;
	END_IF	
	
	
	IF bEnableBeltTracking THEN
		stRobotPathPlanner[1].stRobotPoints[2].bEnableCondition:= bSetBeltTrackingPickDone  ;
		stRobotPathPlanner[1].stRobotPoints[4].bEnableCondition:=bPickDone;
		bPlaceDone:= stRobotPathPlanner[1].stRobotPoints[6].bMoveToDone;
		stRobotPathPlanner[1].stRobotPoints[7].bEnableCondition:=bPlaceDone;
	END_IF
	
	// ***************************************************** ABSOLUTE DESYNCRONIZATION ********************************************
	// Desynch if no place point available after pick 
	IF bDesynchAfterPick THEN // Missing Place po0int after pick done
		IF stPathPlannerFbk[1].usiBufferedBlock = 4 THEN
			stRobotPathPlanner[1].stRobotPoints[4].usiJumpAfter:=1; // Go to Home
			stRobotPathPlanner[1].stPathPlannerCmd.bInTouchProbeStop:=TRUE;
		END_IF
		IF stPathPlannerFbk[1].usiBufferedBlock = 1 THEN
			stRobotPathPlanner[1].stPathPlannerCmd.bInTouchProbeStop:=FALSE;
			bDesynchAfterPick:=FALSE;
			stRobotPathPlanner[1].stRobotPoints[1].usiJumpAfter:=0; // Stay in Home
		END_IF
	END_IF
	// Desynch if no pick point available after place 
	IF bDesynchAfterPlace THEN // Missing Place po0int after pick done
		IF stPathPlannerFbk[1].usiBufferedBlock = 7 THEN
			stRobotPathPlanner[1].stRobotPoints[7].usiJumpAfter:=1; // Go to Home
			stRobotPathPlanner[1].stPathPlannerCmd.bInTouchProbeStop:=TRUE;
		END_IF
		IF stPathPlannerFbk[1].usiBufferedBlock = 1 THEN
			stRobotPathPlanner[1].stPathPlannerCmd.bInTouchProbeStop:=FALSE;
			bDesynchAfterPlace:=FALSE;
			stRobotPathPlanner[1].stRobotPoints[1].usiJumpAfter:=0; // Stay in Home
		END_IF
	END_IF
	
	
// ######################################### Belt Axis Commands Example ###########################################################


stBeltAxis1.AxisName:='Belt1';

fbPowerOnBeltAxis1(
	Enable:= bEnPowerBeltAxis1, 
	Status=&gt; , 
	Error=&gt; , 
	ErrorID=&gt; , 
	ErrorIdent=&gt; , 
	Axis:=stBeltAxis1 );
	
fbMoveVelBeltAxis1(
