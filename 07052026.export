	Deceleration:= rAccBeltAxis1, 
	Jerk:= , 
	UseAH:= , 
	Done=&gt; , 
	Active=&gt; , 
	CommandAborted=&gt; , 
	Error=&gt; , 
	ErrorID=&gt; , 
	ErrorIdent=&gt; , 
	Axis:= stBeltAxis1);	
	
fbReadActualPosBelt1(
	Enable:= bEnPowerBeltAxis1, 
	Valid=&gt; , 
	Active=&gt; , 
	Error=&gt; , 
	ErrorID=&gt; , 
	ErrorIdent=&gt; , 
	Position=&gt; , 
	Axis:=stBeltAxis1 );	
	
stBeltAxis2.AxisName:='Belt2';

fbPowerOnBeltAxis2(
	Enable:= bEnPowerBeltAxis2, 
	Status=&gt; , 
	Error=&gt; , 
	ErrorID=&gt; , 
	ErrorIdent=&gt; , 
	Axis:=stBeltAxis2 );
	
fbMoveVelBeltAxis2(
	Execute:= bExMoveVelBeltaAxis2, 
	ContinuousUpdate:= , 
	Velocity:= rVelBeltAxis2, 
	DriveVelMode:= , 
	Acceleration:= rAccBeltAxis2, 
	Deceleration:= rAccBeltAxis2, 
	Jerk:= , 
	BufferMode:= , 
	InVelocity=&gt; , 
	Busy=&gt; , 
	Active=&gt; , 
	CommandAborted=&gt; , 
	Error=&gt; , 
	ErrorID=&gt; , 
	ErrorIdent=&gt; , 
	Axis:=stBeltAxis2 );
	
fbStopBeltAxis2(
	Execute:=bStopBeltAxis2, 
	Deceleration:= rAccBeltAxis2, 
	Jerk:= , 
	UseAH:= , 
	Done=&gt; , 
	Active=&gt; , 
	CommandAborted=&gt; , 
	Error=&gt; , 
	ErrorID=&gt; , 
	ErrorIdent=&gt; , 
	Axis:= stBeltAxis2);	
	
fbReadActualPosBelt2(
	Enable:= TRUE, 
	Valid=&gt; , 
	Active=&gt; , 
	Error=&gt; , 
	ErrorID=&gt; , 
	ErrorIdent=&gt; , 
	Position=&gt; , 
	Axis:=stBeltAxis2 );		
	
(* bypass	
	// ***************************************************** MOVE JUMP Belt Synch ***********************************************************
IF bEnableExampleMOveJumpBeltSync THEN 
		
	// ******************************* NOTE ON MOVEJUMP SYNCH TO BELT ***************************************
	(*
		If the following Move Jump point is not in the belt area the robot stay synhcronizaed to the belt down in the previous reaced point.
		To avoid this is necessary to program a Move Jump Up ( home ) point to desynchronize from the previous belt when the point on the next belt is not in the belt area
		( see point 14 and point 17 in the recipe file "delta1_reldesync_moveJump" used in the following example )
	*)
	// ************************************* END NOTE *******************************************************

	// Tracking Points from home to pick
	IF stPathPlannerFbk[1].usiBufferedBlock &lt;Point2  THEN 
		stRobotPathPlanner[1].stRobotPoints[Point12].arPos[1]:=stRobotBeltManagement[1].arBeltConfig[1].rXposBelt;
		stRobotPathPlanner[1].stRobotPoints[Point12].arPos[5]:=KinData[1].arPositionOriginalCoord_i[5];
		stRobotPathPlanner[1].stRobotPoints[Point12].arPos[6]:=0;
	END_IF
	
	// Tracking Points from pick to place
	IF  stPathPlannerFbk[1].usiBufferedBlock &lt;Point2 OR stPathPlannerFbk[1].usiBufferedBlock = Point12  OR stPathPlannerFbk[1].usiBufferedBlock = Point13  OR stPathPlannerFbk[1].usiBufferedBlock = Point14 THEN 
		stRobotPathPlanner[1].stRobotPoints[Point16].arPos[1]:=stRobotBeltManagement[1].arBeltConfig[2].rXposBelt;
		stRobotPathPlanner[1].stRobotPoints[Point16].arPos[5]:=0;
		stRobotPathPlanner[1].stRobotPoints[Point16].arPos[6]:=KinData[1].arPositionOriginalCoord_i[6];
	
	END_IF
	
		// Tracking Points from place to pick
	IF stPathPlannerFbk[1].usiBufferedBlock = Point16 OR stPathPlannerFbk[1].usiBufferedBlock = Point17  THEN 
		stRobotPathPlanner[1].stRobotPoints[Point13].arPos[1]:=stRobotBeltManagement[1].arBeltConfig[1].rXposBelt;
		stRobotPathPlanner[1].stRobotPoints[Point13].arPos[5]:=KinData[1].arPositionOriginalCoord_i[5];
		stRobotPathPlanner[1].stRobotPoints[Point13].arPos[6]:=0;
	END_IF

END_IF
*)


					
