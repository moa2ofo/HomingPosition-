            <Single Name="TextBlobForSerialisation" Type="string">///#############################################################################################
///  #############################################################################################
///
///   General Header
///  ---------------------------------------------------------------------------------------------
///   Shortdescription       : Program call of the robot management functions block example
///   Version                : 1.0.0.&lt;br&gt;
///   Name                   : GT DCIT/STS&lt;br&gt;
///   Date                   : 2024-10-25&lt;br&gt;
///   Company                : Bosch Rexroth  S.p.A. Electric Drives and Controls&lt;br&gt;
///   Target                 : CtrlX Core V.2.6.4 &lt;br&gt;
///   Functional description :  
///   Handling specials      : 
///	
///								
///  ---------------------------------------------------------------------------------------------
///
///   Additional Header
///  ---------------------------------------------------------------------------------------------
///   Used global variables  : 
///
///   Used Standard Library  : 
///
///   Used Standard Function Block:	
///	
///   Possible error codes:	
///
///   Last Modified Issues: 
///	   	
///   		Version		: 14.22.1
///   		Name   		: GT DCIT/SAE1-IT
///   		Date   		: 2018-06-02				
///		Description	: a99_Example : Added Orientation axis position copy in circular end destination point	
///		
///  		Version		: 14.22.7.1
///   		Name   		: GT DCIT/SAE1-IT
///   		Date   		: 2021-05-18				
///		Description	: a99_Example : Changed palletization management example	
///  -----------------------------------------------------------------------
///
///
///  ---------------------------------------------------------------------------------------------
///
///  #############################################################################################
///  ############################################################################################# 
PROGRAM prgRobotManagement
VAR

/// Base
	stKinRef: AXES_GROUP_REF;
	fbRobotBase: ARRAY[1..C_usiRobotNo] OF FB_RobotBase_CtrlX;
	/// Path Planner
	fbRobotPathPlanner: ARRAY[1..C_usiRobotNo] OF FB_RobotPathPlanner;
	fbTeachInPoints: ARRAY[1..C_usiRobotNo] OF FB_TeachIn;
	fbRecipeManagement: ARRAY[1..C_usiRobotNo] OF FB_RecipeManager;
	fbRecipeManagementAddData: ARRAY[1..C_usiRobotNo] OF FB_RecipeManager;
	/// bypass	fbBeltManagement: ARRAY[1..C_usiRobotNo] OF FB_BeltManagement;

/// bypass	fbRecipeBeltManagement: ARRAY[1..C_usiRobotNo] OF FB_RecipeManager;
	usiRobot: USINT;
	
/// Example AuxPoint calculation move circular
	bEnableCalcAuxCircPoint: BOOL;
	stOriginPoint: ARRAY[1..16] OF LREAL;
	stDestPoint: ARRAY[1..16] OF LREAL;
	stAuxPoint: ARRAY[1..16] OF LREAL;
	bNegQuadrant: BOOL;
	
/// Example copy points inside the point table to palletize
	bTrxPoint: BOOL;
	bUpdatePlaceDone: BOOL;
	iPlace: INT;
	iPlaceMax: INT := 2;
	bPalletizeDone: BOOL;

///	Example update belt tracking points 
	bEnableExampleBeltTracking: BOOL;
	bDesynchAfterPick: BOOL;
	bDesynchAfterPlace: BOOL;
	bEnableExampleMOveJumpBeltSync: BOOL;
	fbTeachInNew: FB_TeachIn;
	strRecipeAddData: STRING(255);
	bRecipeAddDataCommandDone: BOOL;
	bRecipeCommandDone: BOOL;

//  Start a points sequence without Enable inteblocks with PolySlope or Path Smotth Slope
	fbKinSeqStart: FB_KinPathSmoothAutoSeq;
	bEnableKinSeqStart: BOOL;
	iStartPoint: INT := 2;
	iEndPoint: INT:=6;
	iRepeatCycles: INT;
	fbPolySlopeSeq: FB_KinPathPolyContAutoSeq;
	bEnableKinSeqStartPolySlope:BOOL;

//Active and manage " bSetContinousContourDisableWaitDone" using switch on path at pick done and place done
	rSwitchDistance: REAL := 20;
	rApproxWindow: REAL := 2;
	bPickDone: BOOL;
	bPlaceDone: BOOL;
	tEndTask: LTIME;
	tCycle: LTIME;
	tStartTask: LTIME;

// #############  Belt Tracking ###############
	stBeltValueData: CXA_Motion.ML_AxsGetBeltValueData;
	stTrackingBelt1: CXA_Motion.ML_KinBeltSyncPData;
	bStartBeltTracking: BOOL;
	bTrackingActiveBelt1: BOOL;
	bStopBeltTracking: BOOL;
	rTrackingPosBelt1: LREAL;
	fbReadBeltSynStatus: DL_ReadNode;
	bExReadBeltSynStatus: BOOL;
	outValueReadBeltSynStatus: STRING;
	bSetBeltTrackingPickDone: BOOL;
	bEnableBeltTracking:BOOL;

// ########## Belt Axis Commands Example #########################
// ###################  Belt Axis #############################
	
	fbPowerOnBeltAxis1: MC_Power;
	fbMoveVelBeltAxis1: MC_MoveVelocity;
	fbStopBeltAxis1: MC_Stop;
	bEnPowerBeltAxis1: BOOL;
	stBeltAxis1: AXIS_REF;
	bExMoveVelBeltaAxis1: BOOL;
	rVelBeltAxis1: LREAL := 2000;
	rAccBeltAxis1: LREAL := 10000;
	bStopBeltAxis1: BOOL;
	fbReadActualPosBelt1: MC_ReadActualPosition;
	
	fbPowerOnBeltAxis2: MC_Power;
	fbMoveVelBeltAxis2: MC_MoveVelocity;
	fbStopBeltAxis2: MC_Stop;
	bEnPowerBeltAxis2: BOOL;
	stBeltAxis2: AXIS_REF;
	bExMoveVelBeltaAxis2: BOOL;
	rVelBeltAxis2: LREAL := 2000;
	rAccBeltAxis2: LREAL := 10000;
	bStopBeltAxis2: BOOL;
	fbReadActualPosBelt2: MC_ReadActualPosition;
	
	
END_VAR
</Single>
