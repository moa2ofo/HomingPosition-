            <Single Name="TextBlobForSerialisation" Type="string">	///#############################################################################################
	///  #############################################################################################
	///
	///   General Header
	///  ---------------------------------------------------------------------------------------------
	///   Shortdescription       :  
	///   Version                : 1.0.0.&lt;br&gt;
	///   Name                   : GT DCIT/STS&lt;br&gt;
	///   Date                   : 2024-10-25&lt;br&gt;
	///   Company                : Bosch Rexroth  S.p.A. Electric Drives and Controls&lt;br&gt;
	///   Target                 : CtrlX Core V.2.6.4 &lt;br&gt;
	///   Functional description : Define here the robots and robots Axis names
	///   Handling specials      : 
	///								* global var arRobotKinConfig name must not be changed.
	///							    * axis definition global var arRobot..n..AxisConfig name could be changed
	///								  but thenew name must be update in global var arRobotKinConfig too. 									
	///	
	///								
	///  ---------------------------------------------------------------------------------------------
	///
	///   Additional Header
	///  ---------------------------------------------------------------------------------------------
	///   Used global variables  : 
	///
	///   Used Standard Library  : []	
	///
	///   Used Standard Function Block:	
	///      
	///   Possible error codes:	
	///
	///   Last Modified Issues: 
	///											
	///  -----------------------------------------------------------------------
	///
	///
	///  ---------------------------------------------------------------------------------------------
	///
	///  #############################################################################################
	///  ############################################################################################# 
VAR_GLOBAL
	arRobot1AxisConfig: ARRAY[1..16] OF ST_AXIS_REF := [(AxisRef := (AxisName := 'Axis_1'), AxisNo := 1, AxisConfig := enPositioningAxis, AxisType := enVirtualAxis), 
														(AxisRef := (AxisName := 'Axis_2'), AxisNo := 2, AxisConfig := enPositioningAxis, AxisType := enVirtualAxis), 
														(AxisRef := (AxisName := 'Axis_3'), AxisNo := 3, AxisConfig := enPositioningAxis, AxisType := enVirtualAxis),
														(AxisRef := (AxisName := 'Axis_4'), AxisNo := 4, AxisConfig := enPositioningAxis, AxisType := enVirtualAxis), 
														(AxisRef := (AxisName := 'Axis_5'), AxisNo := 5, AxisConfig := enPositioningAxis, AxisType := enVirtualAxis), 
														(AxisRef := (AxisName := 'Axis_6'), AxisNo := 6, AxisConfig := enPositioningAxis, AxisType := enVirtualAxis)];
														
														
	arRobotKinConfig: ARRAY[1..16] OF ST_KIN_REF := [	(KinRef := (KinName := 'Rob_Arm_5dof'), KinNo := 1, arAxisRef := arRobot1AxisConfig )];
END_VAR</Single>
