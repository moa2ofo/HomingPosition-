            <Single Name="TextBlobForSerialisation" Type="string">///#############################################################################################
///  #############################################################################################
///
///   General Header
///  ---------------------------------------------------------------------------------------------
///   Shortdescription       : Global Variable for Robot Management
///   Version                : 1.0.0.&lt;br&gt;
///   Name                   : GT DCIT/STS&lt;br&gt;
///   Date                   : 2024-10-25&lt;br&gt;
///   Company                : Bosch Rexroth  S.p.A. Electric Drives and Controls&lt;br&gt;
///   Target                 : CtrlX Core V.3.6.0 &lt;br&gt;
///   Functional description : 
///   Handling specials      :    -
///   
///   Last modification	  :
/// 
///   Version               : 3.6.1.3 &lt;br&gt;
///   Name                  : GT DCIT/STS&lt;br&gt;
///   Date                  : 2025-06-16&lt;br&gt;
///	  Company               : Bosch Rexroth  S.p.A. Electric Drives and Controls&lt;br&gt;
///   Target                : CtrlX Core V.3.6.0 &lt;br&gt;
///	  Modified POUs			: FB_RobotPathPlannerManagement&lt;br&gt;
///   Description 			: Chage point managament : added global cosstant to magage system buffer max full and max empty to enable to send points  &lt;br&gt;
///													iBufferLimit:INT:=50; 			// Higher Points Buffer Limit&lt;br&gt;
///													iBufferLimitMin: INT := 20;		// Lower Points Buffer Limit&lt;br&gt;
///													iBufferSizeContour : INT :=15 ;  // Buffer size of the kin contour function&lt;br&gt;
///&lt;br&gt;  

///
/// ---------------------------------------------------------------------------------------------
///	
///  ---------------------------------------------------------------------------------------------
{attribute 'symbol' := 'readwrite'}
VAR_GLOBAL
	stRobotPathPlanner: ARRAY[1..C_usiRobotNo] OF ST_RobotPathPlanner;
	stPathPlannerFbk: ARRAY[1..C_usiRobotNo] OF ST_PathPlanner_FBK;
	stKinPathBlendingStatus:ARRAY[1..C_usiRobotNo] OF ST_KIN_PATH_STATUS; /// Status of the kinematic blend option and contour
END_VAR

</Single>
