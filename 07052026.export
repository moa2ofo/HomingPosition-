        <Single Name="setup_call_pou_guid" Type="System.Guid">b4deb95a-6882-519e-8e43-14cbb377f63f</Single>
        <Single Name="sys_setup_pou_guid" Type="System.Guid">e58e72f2-338c-5f32-ba08-c886e2ccbeae</Single>
        <Single Name="profiler_global_vars_guid" Type="System.Guid">9907dfb1-f26a-5924-affc-5c44eddcf271</Single>
