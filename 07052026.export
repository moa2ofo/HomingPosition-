            <Single Name="TextBlobForSerialisation" Type="string">tStartTask := LTIME();
// Robot management
FOR usiRobot := 1 TO C_usiRobotNo DO
	a00_RobotBase();
	a01_PathPlanner();
	a02_TeachIn();	
	// a03_Belt();
	// a99_Examples();
END_FOR
tEndTask := LTIME();
