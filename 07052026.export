        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">fbECATCoeWriteSdo.Execute      := bstartwrite;
fbECATCoeWriteSdo.MasterName   := ADR(strMasterNameW);
fbECATCoeWriteSdo.SlaveAddress := 1001;
fbECATCoeWriteSdo.Index        := wIndexW;
fbECATCoeWriteSdo.SubIndex     := bySubIndexW;
fbECATCoeWriteSdo.ValueAdr     := ADR(byWriteValue);
fbECATCoeWriteSdo.SizeOfValue  := SIZEOF(byWriteValue);
fbECATCoeWriteSdo();

IF TRUE = fbECATCoeWriteSdo.Done THEN
  ; // FB finished . byWriteValue was written to slave.
END_IF
IF TRUE = fbECATCoeWriteSdo.Error THEN
  ; // Error handling
END_IF

// Example A : read Vendor ID
fbECATCoeReadSdo.Execute      := bstartread;
fbECATCoeReadSdo.MasterName   := ADR(strMasterName);
fbECATCoeReadSdo.SlaveAddress := 1001;
fbECATCoeReadSdo.Index        := wIndex;
fbECATCoeReadSdo.SubIndex     := bySubIndex;
fbECATCoeReadSdo.ValueAdr     := ADR(udiVendorId);
fbECATCoeReadSdo.SizeOfValue  := SIZEOF(udiVendorId);
fbECATCoeReadSdo();
IF TRUE = fbECATCoeReadSdo.Done THEN
  ; // FB finished . Vendor ID is in udiVendorId.
END_IF
IF TRUE = fbECATCoeReadSdo.Error THEN
  ; // Error handling
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">269812f9-4376-45da-b3bb-2fd20a048840_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM PLC_PRG
VAR
  fbECATCoeReadSdo : IL_ECATCoeReadSdo;
  strMasterName    : STRING := 'ethercatmaster';
  boExecute        : BOOL   := FALSE;
  uiEthercatAddr   : UINT   := 1001;
  wIndex           : WORD   :=16#6061; // Identity Object
  bySubIndex       : BYTE   := 0;       // Vendor ID
  udiVendorId      : UDINT;
	bstartread: BOOL;
	// Example A : write 1 Byte value
  fbECATCoeWriteSdo : IL_ECATCoeWriteSdo;
  strMasterNameW     : STRING := 'ethercatmaster';
  uiEthercatAddrW    : UINT := 1001;
  wIndexW            : WORD := 16#6060;  // device specific Index/SubIndex
  bySubIndexW        : BYTE := 0;        // ... which is writeable!
  byWriteValue      : BYTE := 16#06;
  bstartwrite: BOOL;
END_VAR	</Single>
            <Single Name="LineInfoPersistence" Type="string">269812f9-4376-45da-b3bb-2fd20a048840_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">110</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">67012c76-1e49-45e3-8ee8-2656db3aaa13</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">426cf649-f9c3-487a-80c1-73c695816adf</Single>
        <Single Name="ParentGuid" Type="System.Guid">67012c76-1e49-45e3-8ee8-2656db3aaa13</Single>
        <Single Name="Name" Type="string">POU_GetBusState</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639148032932841709</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">fbECATMasterSetBusState.Execute     := FALSE;
fbECATMasterSetBusState.MasterName  := ADR(strMasterName);
fbECATMasterGetBusState.MasterName := ADR(strMasterName);
ElacIdAddress := 0;


fbECATMasterGetBusState();

// IF FALSE = fbECATMasterSetBusState.Done AND 
//    TRUE = fbECATMasterGetBusState.Done AND 
//    fbECATMasterGetBusState.ActBusState = IL_ECAT_STATE.ECAT_STATE_OP AND  
//    ElacArrayHoming[ArrayCounter].FsHoming = IN_OP_NO_HOMING THEN
//    
//   fbECATMasterSetBusState.Execute := TRUE;
//   fbECATMasterSetBusState.NewBusState := IL_ECAT_STATE.ECAT_STATE_PREOP;
//   eActBusState := fbECATMasterGetBusState.ActBusState;
// END_IF

IF  ElacArrayHoming[ArrayCounter].FsHoming = FROM_PREOP_OP_HOME_DONE THEN
	fbECATMasterSetBusState.Execute := TRUE;
	fbECATMasterSetBusState.NewBusState := IL_ECAT_STATE.ECAT_STATE_OP;
END_IF

//IF TRUE = fbECATMasterSetBusState.Done AND ElacArrayHoming[ArrayCounter].FsHoming &lt;&gt; FROM_PREOP_OP_HOME_DONE THEN
IF fbECATMasterGetBusState.ActBusState = IL_ECAT_STATE.ECAT_STATE_PREOP THEN	
	fbECATCoeReadSdo.SlaveAddress := ElacArrayHoming[ArrayCounter].SlaveAddress;
	fbECATCoeWriteSdo.SlaveAddress := ElacArrayHoming[ArrayCounter].SlaveAddress;
	fbECATCoeWriteSdo.MasterName   := ADR(strMasterName);
	fbECATCoeReadSdo.MasterName   := ADR(strMasterName);
	
	IF ElacArrayHoming[ArrayCounter].FsSdoSetUp_u = HOMING_MODE THEN
		wIndex       := 16#6061; // Identity Object
		bySubIndex          := 0;       // Vendor ID
		wIndexW           := 16#6060;  // device specific Index/SubIndex
		bySubIndexW        := 0;        // ... which is writeable!
		byWriteValue     := 16#06;

		fbECATCoeWriteSdo.Execute      := TRUE;
		fbECATCoeWriteSdo.Index        := wIndexW;
		fbECATCoeWriteSdo.SubIndex     := bySubIndexW;
		fbECATCoeWriteSdo.ValueAdr     := ADR(byWriteValue);
		fbECATCoeWriteSdo.SizeOfValue  := SIZEOF(byWriteValue);
		fbECATCoeReadSdo.Execute      := TRUE;
		fbECATCoeReadSdo.Index        := wIndex;
		fbECATCoeReadSdo.SubIndex     := bySubIndex;
		fbECATCoeReadSdo.ValueAdr     := ADR(ElacArrayHoming[ArrayCounter].WorkingMode);
		fbECATCoeReadSdo.SizeOfValue  := SIZEOF(ElacArrayHoming[ArrayCounter].WorkingMode);
	END_IF
	
	IF  ElacArrayHoming[ArrayCounter].FsSdoSetUp_u = METH_AND_ANGLE THEN 
		wIndexW := 16#6098;
		byWriteValue := 37; // setting homing method 37
		wIndex := 16#201F;
		bySubIndexW := 0;
		bySubIndex := 0;
		
		fbECATCoeWriteSdo.Execute      := TRUE;
		fbECATCoeWriteSdo.Index        := wIndexW;
		fbECATCoeWriteSdo.SubIndex     := bySubIndexW;
		fbECATCoeWriteSdo.ValueAdr     := ADR(byWriteValue);
		fbECATCoeWriteSdo.SizeOfValue  := SIZEOF(byWriteValue);
		fbECATCoeReadSdo.Execute      := TRUE;
		fbECATCoeReadSdo.Index        := wIndex;
		fbECATCoeReadSdo.SubIndex     := bySubIndex;
		fbECATCoeReadSdo.ValueAdr     := ADR(ElacArrayHoming[ArrayCounter].OuterAngle);
		fbECATCoeReadSdo.SizeOfValue  := SIZEOF(ElacArrayHoming[ArrayCounter].OuterAngle);
		//re_offset_input_angle := ((ElacArrayHoming[0].OuterAngle*FEED_COSTANT*GEAR_RATIO)/(ROUND_ANGLE));
		
	END_IF
	
		IF  ElacArrayHoming[ArrayCounter].FsSdoSetUp_u = FEED_CONSTANT THEN 
		wIndexW := 16#6092; //Feed constant 
		wIndex := 16#6092; //Feed constant 
		bySubIndexW := 1;
		bySubIndex := 1;
		
		fbECATCoeWriteSdo.Execute      := TRUE;
		fbECATCoeWriteSdo.Index        := wIndexW;
		fbECATCoeWriteSdo.SubIndex     := bySubIndexW;
		fbECATCoeWriteSdo.ValueAdr     := ADR(ElacArrayHoming[ArrayCounter].FeedConstant_w);
		fbECATCoeWriteSdo.SizeOfValue  := SIZEOF(ElacArrayHoming[ArrayCounter].FeedConstant_w);
		fbECATCoeReadSdo.Execute      := TRUE;
		fbECATCoeReadSdo.Index        := wIndex;
		fbECATCoeReadSdo.SubIndex     := bySubIndex;
		fbECATCoeReadSdo.ValueAdr     := ADR(ElacArrayHoming[ArrayCounter].FeedConstant_r);
		fbECATCoeReadSdo.SizeOfValue  := SIZEOF(ElacArrayHoming[ArrayCounter].FeedConstant_r);
	END_IF
	IF  ElacArrayHoming[ArrayCounter].FsSdoSetUp_u = GEAR_RATIO_SUB1 THEN 
		wIndexW := 16#6091; //GearRatio 
		wIndex := 16#6091; //GearRatio 
		bySubIndexW := 1;
		bySubIndex := 1;
		
		fbECATCoeWriteSdo.Execute      := TRUE;
		fbECATCoeWriteSdo.Index        := wIndexW;
		fbECATCoeWriteSdo.SubIndex     := bySubIndexW;
		fbECATCoeWriteSdo.ValueAdr     := ADR(ElacArrayHoming[ArrayCounter].GearRatio_sub1_w);
		fbECATCoeWriteSdo.SizeOfValue  := SIZEOF(ElacArrayHoming[ArrayCounter].GearRatio_sub1_w);
		fbECATCoeReadSdo.Execute      := TRUE;
		fbECATCoeReadSdo.Index        := wIndex;
		fbECATCoeReadSdo.SubIndex     := bySubIndex;
		fbECATCoeReadSdo.ValueAdr     := ADR(ElacArrayHoming[ArrayCounter].GearRatio_sub1_r);
		fbECATCoeReadSdo.SizeOfValue  := SIZEOF(ElacArrayHoming[ArrayCounter].GearRatio_sub1_r);
	END_IF
		IF  ElacArrayHoming[ArrayCounter].FsSdoSetUp_u = GEAR_RATIO_SUB2 THEN 
		wIndexW := 16#6091; //GearRatio
		wIndex := 16#6091; //GearRatio
		bySubIndexW := 2;
		bySubIndex := 2;
		
		fbECATCoeWriteSdo.Execute      := TRUE;
		fbECATCoeWriteSdo.Index        := wIndexW;
		fbECATCoeWriteSdo.SubIndex     := bySubIndexW;
		fbECATCoeWriteSdo.ValueAdr     := ADR(ElacArrayHoming[ArrayCounter].GearRatio_sub2_w);
		fbECATCoeWriteSdo.SizeOfValue  := SIZEOF(ElacArrayHoming[ArrayCounter].GearRatio_sub2_w);
		fbECATCoeReadSdo.Execute      := TRUE;
		fbECATCoeReadSdo.Index        := wIndex;
		fbECATCoeReadSdo.SubIndex     := bySubIndex;
		fbECATCoeReadSdo.ValueAdr     := ADR(ElacArrayHoming[ArrayCounter].GearRatio_sub2_r);
		fbECATCoeReadSdo.SizeOfValue  := SIZEOF(ElacArrayHoming[ArrayCounter].GearRatio_sub2_r);
	END_IF
	
	IF ElacArrayHoming[ArrayCounter].FsSdoSetUp_u = WRITE_OFFSET AND ElacArrayHoming[ArrayCounter].OffesetInnerAngle_w &lt;&gt; 700000  THEN 
		
		wIndexW := 16#607C;
		wIndex := 16#607C;
		bySubIndexW := 0;
		bySubIndex := 0;
		
		fbECATCoeWriteSdo.Execute      := TRUE;
		fbECATCoeWriteSdo.Index        := wIndexW;
		fbECATCoeWriteSdo.SubIndex     := bySubIndexW;
		fbECATCoeWriteSdo.ValueAdr     := ADR(ElacArrayHoming[ArrayCounter].OffesetInnerAngle_w);
		fbECATCoeWriteSdo.SizeOfValue  := SIZEOF(ElacArrayHoming[ArrayCounter].OffesetInnerAngle_w);
		fbECATCoeReadSdo.Execute      := TRUE;
		fbECATCoeReadSdo.Index        := wIndex;
		fbECATCoeReadSdo.SubIndex     := bySubIndex;
		fbECATCoeReadSdo.ValueAdr     := ADR(ElacArrayHoming[ArrayCounter].OffesetInnerAngle_r);
		fbECATCoeReadSdo.SizeOfValue  := SIZEOF(ElacArrayHoming[ArrayCounter].OffesetInnerAngle_r);
	END_IF
	
	IF ElacArrayHoming[ArrayCounter].FsSdoSetUp_u = WRITE_OFFSET 
		AND ElacArrayHoming[ArrayCounter].OffesetInnerAngle_w = ElacArrayHoming[ArrayCounter].OffesetInnerAngle_r THEN
		ElacArrayHoming[ArrayCounter].FsHoming := HOMING_DONE;
	END_IF
	
	IF ElacArrayHoming[ArrayCounter].FsSdoSetUp_u = HOMING_MODE AND ElacArrayHoming[ArrayCounter].WorkingMode = HOMING_MODE_6061 THEN 
		ElacArrayHoming[0].FsSdoSetUp_u := FEED_CONSTANT;		
		fbECATCoeWriteSdo.Execute      := FALSE;
		fbECATCoeReadSdo.Execute      := FALSE;
		fbECATMasterSetBusState.Execute := FALSE;
	END_IF
	
	IF ElacArrayHoming[ArrayCounter].FsHoming = HOMING_DONE THEN 
		ElacArrayHoming[ArrayCounter].FsHoming := FROM_PREOP_OP_HOME_DONE;
		fbECATCoeWriteSdo.Execute      := FALSE;
		fbECATCoeReadSdo.Execute      := FALSE;
		fbECATMasterSetBusState.Execute := FALSE;
	END_IF
	
	IF ElacArrayHoming[ArrayCounter].FsSdoSetUp_u = FEED_CONSTANT AND 
	ElacArrayHoming[ArrayCounter].FeedConstant_r = ElacArrayHoming[ArrayCounter].FeedConstant_w THEN 
		ElacArrayHoming[ArrayCounter].FsSdoSetUp_u := GEAR_RATIO_SUB1;
		fbECATCoeWriteSdo.Execute      := FALSE;
		fbECATCoeReadSdo.Execute      := FALSE;
		fbECATMasterSetBusState.Execute := FALSE;
	END_IF
	IF ElacArrayHoming[ArrayCounter].FsSdoSetUp_u = GEAR_RATIO_SUB1 AND 
	ElacArrayHoming[ArrayCounter].GearRatio_sub1_w = ElacArrayHoming[ArrayCounter].GearRatio_sub1_r THEN 
		ElacArrayHoming[ArrayCounter].FsSdoSetUp_u := GEAR_RATIO_SUB2;
		fbECATCoeWriteSdo.Execute      := FALSE;
		fbECATCoeReadSdo.Execute      := FALSE;
		fbECATMasterSetBusState.Execute := FALSE;
	END_IF
	IF ElacArrayHoming[ArrayCounter].FsSdoSetUp_u = GEAR_RATIO_SUB2 AND 
	ElacArrayHoming[ArrayCounter].GearRatio_sub2_w = ElacArrayHoming[ArrayCounter].GearRatio_sub2_r THEN 
		ElacArrayHoming[ArrayCounter].FsSdoSetUp_u := METH_AND_ANGLE;
		fbECATCoeWriteSdo.Execute      := FALSE;
		fbECATCoeReadSdo.Execute      := FALSE;
		fbECATMasterSetBusState.Execute := FALSE;
	END_IF



	
	IF ElacArrayHoming[ArrayCounter].FsSdoSetUp_u = METH_AND_ANGLE AND  ElacArrayHoming[ArrayCounter].OuterAngle &lt;&gt; 700000 THEN 
		ElacArrayHoming[ArrayCounter].OffesetInnerAngle_w := TO_DINT(((ElacArrayHoming[ArrayCounter].OuterAngle*FEED_COSTANT*GEAR_RATIO)/(ROUND_ANGLE)));
		ElacArrayHoming[ArrayCounter].FsSdoSetUp_u := WRITE_OFFSET;
		fbECATCoeWriteSdo.Execute      := FALSE;
		fbECATCoeReadSdo.Execute      := FALSE;
		fbECATMasterSetBusState.Execute := FALSE;
	END_IF
	
	IF fbECATCoeWriteSdo.Done = TRUE THEN 
		fbECATCoeWriteSdo.Execute      := FALSE;
		fbECATCoeReadSdo.Execute      := FALSE;
		fbECATMasterSetBusState.Execute := FALSE;		
	END_IF

	fbECATCoeWriteSdo();
	fbECATCoeReadSdo();
	
	IF TRUE = fbECATCoeWriteSdo.Done THEN
	  ; // FB finished . byWriteValue was written to slave.
	END_IF
	IF TRUE = fbECATCoeWriteSdo.Error THEN
	  ; // Error handling
	END_IF
	
	IF TRUE = fbECATCoeReadSdo.Done THEN
	  ; // FB finished . Vendor ID is in udiVendorId.
	END_IF
	IF TRUE = fbECATCoeReadSdo.Error THEN
	  ; // Error handling
	END_IF
END_IF

IF  FALSE = fbECATMasterSetBusState.Done THEN
	fbECATMasterGetBusState.Execute := NOT fbECATMasterGetBusState.Execute;
END_IF

fbECATMasterSetBusState();


IF TRUE = fbECATMasterSetBusState.Error THEN
  ; // error handling
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">426cf649-f9c3-487a-80c1-73c695816adf_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM POU_GetBusState
VAR
  fbECATMasterSetBusState: IL_ECATMasterSetBusState;
  udiSdoRead      : UDINT;
  fbECATMasterGetBusState: IL_ECATMasterGetBusState;
  eActBusState :           IL_ECAT_STATE;
  fbECATCoeReadSdo : IL_ECATCoeReadSdo;
  fbECATCoeWriteSdo : IL_ECATCoeWriteSdo;
  wIndex           : WORD   :=16#6061; // Identity Object
  bySubIndex       : BYTE   := 0;       // Vendor ID
  wIndexW            : WORD := 16#6060;  // device specific Index/SubIndex
  bySubIndexW        : BYTE := 0;        // ... which is writeable!
  byWriteValue      : BYTE := 16#06;
END_VAR


VAR CONSTANT
  FEED_COSTANT : UINT := 6000;
  GEAR_RATIO   : INT  := -100;
  ROUND_ANGLE  : UINT := 360;
  strMasterName:           STRING := 'ethercatmaster';
  HOMING_MODE_6061 : UINT := 6;
END_VAR

</Single>
            <Single Name="LineInfoPersistence" Type="string">426cf649-f9c3-487a-80c1-73c695816adf_Decl_LineIds</Single>
          </Single>
        </Single>
