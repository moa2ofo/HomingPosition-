            <Single Name="TextBlobForSerialisation" Type="string">//{attribute 'qualified_only'}

VAR_GLOBAL
	//st values
	IN_OP_NO_HOMING   : UINT   			   := 0;
	FROM_OP_PREOP_HOME_NOT_DONE   : UINT   := 1;
	HOMING_DONE   : UINT   				   := 2;
	FROM_PREOP_OP_HOME_DONE   : UINT       := 3;

	HOMING_MODE : UINT := 0;
	FEED_CONSTANT : UINT := 1;
	GEAR_RATIO_SUB1 : UINT := 2;
	GEAR_RATIO_SUB2 : UINT := 3;
	METH_AND_ANGLE : UINT := 4;
	WRITE_OFFSET : UINT := 5;

	re_offset_input_angle : REAL := 0;
	ArrayCounter : UINT := 0;
	
    ElacArrayHoming : ARRAY[0..0] OF HomeStruct := [
        (
            FsSdoSetUp_u := 0,
            SlaveAddress := 1001,
			WorkingMode := 0, 
            FsHoming := 0,
            OuterAngle := 700000,
            OffesetInnerAngle_w := 700000,
			OffesetInnerAngle_r := 0,
			HomeOffsetDone := FALSE,
			FeedConstant_w := 7000,
			GearRatio_sub1_w := 2,
			GearRatio_sub2_w := 2,
			FeedConstant_r := 0,
			GearRatio_sub1_r := 0,
			GearRatio_sub2_r := 0
        )
    ];
	ElacIdAddress : UINT := 0;

END_VAR</Single>
