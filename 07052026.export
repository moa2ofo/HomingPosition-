	ContinuousUpdate:= , 
	Velocity:= rVelBeltAxis1, 
	DriveVelMode:= , 
	Acceleration:= rAccBeltAxis1, 
	Deceleration:= rAccBeltAxis1, 
	Jerk:= , 
	BufferMode:= , 
